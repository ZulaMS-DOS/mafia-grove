generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  discordId   String   @unique
  username    String
  avatar      String?
  roleIds     String[] // rolurile Discord ale userului
  points      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions      WorkSession[]
  leaveRequests LeaveRequest[]
  resignations  Resignation[]
  pointsGiven   PointHistory[] @relation("ModeratorPoints")
  pointsReceived PointHistory[] @relation("UserPoints")

  approvedLeaves    LeaveRequest[] @relation("ApprovedLeaves")
  approvedResigns   Resignation[]  @relation("ApprovedResigns")
  taxPayments  TaxPayment[]
  shopOrders  ShopOrder[]
  wheelSpins  WheelSpin[]
  taskClaims  TaskClaim[]
  notifications Notification[]
  amenziPrimite  Amenda[] @relation("AmendaPrimita")
  menziDate     Amenda[] @relation("AmendaData")
}

model WorkSession {
  id           String    @id @default(cuid())
  userId       String
  clockIn      DateTime
  clockOut     DateTime?
  totalMinutes Int?
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id         String      @id @default(cuid())
  userId     String
  reason     String
  startDate  DateTime
  endDate    DateTime
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime    @default(now())

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approver User? @relation("ApprovedLeaves", fields: [approvedBy], references: [id])
}

model Resignation {
  id         String           @id @default(cuid())
  userId     String
  reason     String
  status     ResignationStatus @default(PENDING)
  approvedBy String?
  approvedAt DateTime?
  createdAt  DateTime         @default(now())

  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approver User? @relation("ApprovedResigns", fields: [approvedBy], references: [id])
}

model PointHistory {
  id          String   @id @default(cuid())
  userId      String
  moderatorId String
  amount      Int
  reason      String
  createdAt   DateTime @default(now())

  user      User @relation("UserPoints",     fields: [userId],      references: [id], onDelete: Cascade)
  moderator User @relation("ModeratorPoints",fields: [moderatorId], references: [id], onDelete: Cascade)
}

enum LeaveStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ResignationStatus {
  PENDING
  ACCEPTED
  REJECTED
}
model Whitelist {
  id        String   @id @default(cuid())
  discordId String   @unique
  username  String?
  addedBy   String
  createdAt DateTime @default(now())
}
model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  important Boolean  @default(false)
  author    String
  authorId  String
  createdAt DateTime @default(now())
}
model TaxItem {
  id        String   @id @default(cuid())
  name      String
  bucati    Int      @default(0)
  termen    String   @default("")
  weekStart DateTime
  createdBy String
  createdAt DateTime @default(now())
}
model TaxPayment {
  id        String    @id @default(cuid())
  userId    String
  weekStart DateTime
  paid      Boolean   @default(false)
  paidAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}
model ShopItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  price       Int
  stock       Int      @default(-1) // -1 = infinit
  active      Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders ShopOrder[]
}

model ShopOrder {
  id        String   @id @default(cuid())
  userId    String
  itemId    String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
}
model WheelPrize {
  id        String   @id @default(cuid())
  label     String
  type      String   @default("points") // "points" sau "item"
  value     Int      @default(0)        // puncte acordate sau itemId daca e item
  itemId    String?                     // optional - daca e item din shop
  chance    Int      @default(10)       // sansa in procente (toate trebuie sa dea 100)
  color     String   @default("#00ff66")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model WheelSpin {
  id        String   @id @default(cuid())
  userId    String
  prizeId   String
  prizeLabel String
  cost      Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WheelConfig {
  id        String   @id @default(cuid())
  spinCost  Int      @default(10)
  updatedAt DateTime @updatedAt
}
model Task {
  id          String   @id @default(cuid())
  title       String
  description String
  points      Int
  stock       Int      @default(-1) // -1 = nelimitat
  active      Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())

  claims TaskClaim[]
}
model TaskClaim {
  id        String      @id @default(cuid())
  taskId    String
  userId    String
  status    ClaimStatus @default(PENDING)
  claimedAt DateTime    @default(now())
  reviewedBy String?
  reviewedAt DateTime?

  task Task @relation(fields: [taskId],  references: [id], onDelete: Cascade)
  user User @relation(fields: [userId],  references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
}
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // "announcement" | "tax" | "leave" | "resignation" | "task"
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
model Amenda {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation("AmendaPrimita", fields: [userId], references: [id], onDelete: Cascade)
  issuedById String
  issuer     User      @relation("AmendaData",    fields: [issuedById], references: [id])
  reason     String    // motivul amenzii
  item       String    // ce trebuie adus (ex: trabucuri, capsule, bani)
  bucati     Int       @default(1)  // cantitatea
  termen     DateTime  // termenul limita
  status     String    @default("PENDING") // PENDING | PAID | CANCELLED
  createdAt  DateTime  @default(now())
  paidAt     DateTime?
}




